{
	frankenphp
	order php_server before file_server
}

{$SERVER_NAME:localhost}

root * /app/public
encode gzip

# Seul le contrôleur frontal Laravel peut être exécuté : aucun fichier .php
# déposé ailleurs (ex. public/storage via un upload) ne doit jamais s'exécuter.
@php_interdit {
	path *.php
	not path /index.php
}
respond @php_interdit 404

# Les fichiers uploadés sont servis comme fichiers statiques, sans interprétation
header /storage/* X-Content-Type-Options nosniff

php_server
